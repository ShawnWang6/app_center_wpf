<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>ReportMaker</RootNamespace>
    <AssemblyName>ReportMaker</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <NeutralLanguage>zh</NeutralLanguage>
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<!-- 👇 在这里配置版本号 -->
    <!--AssemblyVersion>1.0.0.0</AssemblyVersion--><!-- 程序集版本：CLR 加载时使用，应精确 -->
    <FileVersion>1.1.0.0</FileVersion><!-- 文件版本：Windows 文件属性中显示 -->
    <!--Version>1.0.0</Version--><!-- 包版本：用于 NuGet，可省略最后一位 -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Images\**" />
    <EmbeddedResource Remove="Images\**" />
    <None Remove="Images\**" />
    <Page Remove="Images\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite 核心包 -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.0" />  
    <!-- ✅ 关键：这个包会自动初始化 SQLitePCL.raw -->    
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="6.0.0" />    
    <PackageReference Include="Serilog" Version="4.4.0" />    
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />    
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="6.0.0" />	
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="6.0.0" />
	<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="6.0.0" />    
    <PackageReference Include="System.Management" Version="6.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    
  </ItemGroup>
  <Target Name="CopyAndRenameReportTemplate" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(ProjectDir)rpt_template.xlsx"
          DestinationFiles="$(OutDir)template.xlsx"
          SkipUnchangedFiles="true" />
	<Copy SourceFiles="$(ProjectDir)zkc_rpt_template.rpt"
          DestinationFiles="$(OutDir)zkcrpt.dat"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
