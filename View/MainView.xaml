<Window x:Class="CtrlCenter.View.AppMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CtrlCenter.ViewModel"         
        mc:Ignorable="d"
        Title="App报表综合管理" Height="600" Width="1023"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        FontSize="16">

    <!--Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext-->
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 全局 DataGrid 行样式：控制悬停颜色 -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6F0FA"/>
                    <!-- 淡蓝色 -->
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
     <Grid Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500" />
                <ColumnDefinition Width="5" />                
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        
         
         <!-- 2. 左侧内容 -->
         <DockPanel Grid.Column="0">
            <!-- 2. 左上App DataGrid -->            
            <DataGrid   AutoGenerateColumns="False" 
                      DockPanel.Dock="Top"
                      RowHeight="50"
                      CanUserAddRows="False" 
                      ItemsSource="{Binding Apps}" 
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                </DataGrid.ColumnHeaderStyle>
                
                <DataGrid.Columns>
                    <DataGridTextColumn 
                            Header="App名称"  
                            Binding="{Binding Name}" 
                            IsReadOnly="True"
                            Width="280" >
                        <!-- 关键：使用 CellStyle 而不是 ElementStyle -->
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <!-- 设置默认背景 -->
                                <Setter Property="Background" Value="Transparent" />

                                <Style.Triggers>
                                    <!-- 根据枚举值改变整个 Cell 的背景 -->
                                    <DataTrigger
                                        Binding="{Binding Status}" 
                                        Value="{x:Static vm:AppStatus.NotInstalled}">
                                        <Setter Property="Background" Value="Red" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}" 
                                        Value="{x:Static vm:AppStatus.StoppedWithLoc}">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" 
                                        Value="{x:Static vm:AppStatus.StoppedWithNoLoc}">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" 
                                        Value="{x:Static vm:AppStatus.RunningWithLoc}">
                                        <Setter Property="Background" Value="LightGreen" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" 
                                        Value="{x:Static vm:AppStatus.RunningWithNoLoc}">
                                        <Setter Property="Background" Value="LightGreen" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                        <!-- 添加 ElementStyle，强制让 TextBlock 垂直居中 -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                <!-- 可选：如果你也希望文本水平居中，可以取消下面一行的注释 -->
                                <!-- <Setter Property="HorizontalAlignment" Value="Center" /> -->
                                <!-- 设置默认背景为透明，否则触发器可能无法覆盖 -->
                                <Setter Property="Background" Value="Transparent" />

                                <!--Style.Triggers>                                    
                                    <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                                        <Setter Property="Background" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="StoppedWithLoc">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="StoppedWithLoc">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="RunningWithNoLoc">
                                        <Setter Property="Background" Value="Green" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="RunningWithLoc">
                                        <Setter Property="Background" Value="Green" />
                                    </DataTrigger>
                                </Style.Triggers-->
                            </Style>
                        </DataGridTextColumn.ElementStyle>                        
                    </DataGridTextColumn>

                <DataGridTemplateColumn Header="操作" Width="240" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="编辑名称" Margin="2,0" 
                                        IsEnabled="{Binding CanEditName}"
                                        Visibility="{Binding CanEditName, Converter={StaticResource BoolToVisibility}}" 
                                        Command="{Binding DataContext.EditAppNameCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="{Binding ActionText}" Margin="2,0"
                                        Command="{Binding DataContext.DynamicActionCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="选择报表目录"  Margin="2,0"
                                        IsEnabled="{Binding CanSelectRptLoc}"
                                        Visibility="{Binding CanSelectRptLoc, Converter={StaticResource BoolToVisibility}}" 
                                        Command="{Binding DataContext.SelectRptLocCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                </DataGrid.Columns>
          </DataGrid>
            <!-- 2. 左下DockPanel -->
            <DockPanel>
                <!-- 2. 左下-上功能按钮 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                <Button Content="合并报表" Margin="2,0" 
                        IsEnabled="{Binding CanMergeRpt}" 
                        Command="{Binding MergeRptCommand}"
                        CommandParameter="{Binding RptFiles}" />
                <Button Content="预览合并报表" Margin="2,0"
                        IsEnabled="{Binding CanPreviewMergedRpt}" 
                        Command="{Binding PreviewMergedRptCommand}"
                        CommandParameter="{Binding RptFiles}" />
            </StackPanel>
                <!-- 2. 左下-下最近报表试图 -->
                <DataGrid   ItemsSource="{Binding RptFiles}" 
                            IsReadOnly="True"
                            AutoGenerateColumns="False" 
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserResizeRows="False"
                            CanUserSortColumns="True"
                            HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="报表类型" Binding="{Binding FileType}" Width="75" IsReadOnly="True"/>
                        <DataGridTextColumn Header="开关编号" Binding="{Binding SwitchNo}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="实验时间" 
                            Binding="{Binding TimeStamp,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                            Width="180"  IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DockPanel>
        
          <!-- 左右分割线 -->
          <GridSplitter Grid.Column="1"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Background="Gray"
               ShowsPreview="True" />

          <!-- 4. 右侧内容 -->
          <Grid Grid.Column="2" Background="LightBlue">
                <!--TextBlock Text="右侧面板" VerticalAlignment="Center" HorizontalAlignment="Center" /-->
                <DockPanel>
                    <Label DockPanel.Dock="Top" Content="历史综合报表" HorizontalAlignment="Center"/>
                    <DataGrid ItemsSource="{Binding RptHis}" 
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        HeadersVisibility="Column"
                        GridLinesVisibility="All" >
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="开关编号" Binding="{Binding SwitchNo}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="试验开始时间"
                                            Binding="{Binding MinTime,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Width="180"
                                            IsReadOnly="True"/>
                        <!--DataGridTextColumn Header="试验结束时间" Binding="{Binding MaxTime}" Width="220" IsReadOnly="True"/-->
                        <DataGridTextColumn Header="合并报表时间"
                                            Binding="{Binding CreateTime,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Width="180" 
                                            IsReadOnly="True"/>
                      </DataGrid.Columns>
                    </DataGrid>                
            </DockPanel>
          </Grid>
     </Grid>   
</Window>
