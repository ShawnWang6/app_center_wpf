<Window x:Class="CtrlCenter.View.AppMainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CtrlCenter.ViewModel"         
        mc:Ignorable="d"
        Title="{Binding AppTitle}" Height="600" Width="1054"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        Topmost="{Binding TopMost}"
        FontSize="16">

    <!--Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext-->
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- 全局 DataGrid 行样式：控制悬停颜色 -->
        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6F0FA"/>
                    <!-- 淡蓝色 -->
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 统一 Button 样式 -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <!--Setter Property="Foreground" Value="White"/-->
            <!--Setter Property="Background" Value="#007ACC"/-->
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!--Setter Property="BorderRadius" Value="4"/-->
            <!-- .NET 6/7/8 支持 -->
        </Style>
    </Window.Resources>
    
     <Grid Background="LightGray">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="510" />
                <ColumnDefinition Width="5" />                
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        
         
         <!-- 2. 左侧内容 -->
         <DockPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal"   DockPanel.Dock="Top">
                <Button Content="{Binding TopMostBtnText}"
                        Command="{Binding ToggleTopmostCommand}"                        
                        Width="128"                        
                        MouseRightButtonDown="TopmostButton_MouseRightButtonDown"
                        Margin="4,0" />
                <Button Content="系统设置"
                        Command="{Binding AppSettingCommand}"
                        Height="48"
                        Visibility="Hidden"
                        Margin="4,0" />
                <Button Content="模拟报表"
                        Height="48"
                        Command="{Binding SimAppRptCommand}"
                        Visibility="{Binding ShowSimTool, Converter={StaticResource BoolToVisibility}}" 
                        Margin="4,0"/>
                <ComboBox ItemsSource="{Binding SimSwitchNos}" 
                          SelectedItem="{Binding SimSelectSwitchNo, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding ShowSimTool, Converter={StaticResource BoolToVisibility}}" 
                          Height="48"
                          Margin="4,0"/>
                <ComboBox ItemsSource="{Binding SimsAppTypes}" 
                          SelectedItem="{Binding SimSelectAppType, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding ShowSimTool, Converter={StaticResource BoolToVisibility}}" 
                          Height="48"
                          Margin="4,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 直接显示枚举名称 -->
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>                
            </StackPanel>
                    <!-- 2. 左上App DataGrid -->            
            <DataGrid AutoGenerateColumns="False" 
                      DockPanel.Dock="Top"
                      RowHeight="50"
                      CanUserAddRows="False" 
                      HeadersVisibility="None"
                      ItemsSource="{Binding Apps}" 
                      SelectionUnit="Cell"
                      SelectionMode="Single"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <!-- 去掉选中效果 -->
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                </DataGrid.ColumnHeaderStyle>
                
                <DataGrid.Columns>                   
                    <DataGridTemplateColumn Header="App" Width="180" IsReadOnly="True">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <!-- 设置默认背景 -->
                                <Setter Property="Background" Value="Transparent" />

                                <Style.Triggers>
                                    <!-- 根据枚举值改变整个 Cell 的背景 -->
                                    <DataTrigger
                Binding="{Binding Status}" 
                Value="{x:Static vm:AppStatus.NotInstalled}">
                                        <Setter Property="Background" Value="Red" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Status}" 
                Value="{x:Static vm:AppStatus.StoppedWithLoc}">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" 
                Value="{x:Static vm:AppStatus.StoppedWithNoLoc}">
                                        <Setter Property="Background" Value="Orange" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" 
                Value="{x:Static vm:AppStatus.RunningWithLoc}">
                                        <Setter Property="Background" Value="LightGreen" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" 
                Value="{x:Static vm:AppStatus.RunningWithNoLoc}">
                                        <Setter Property="Background" Value="LightGreen" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"                                            
                                           Foreground="Black"
                                           Margin="1,0" 
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="350" IsReadOnly="True">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Margin="1,0"
                                        Content="{Binding ActionText}"
                                        Command="{Binding DataContext.DynamicActionCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" />
                                    <Button Content="{Binding SetRptFolderText}"  Margin="2,0"
                                        IsEnabled="{Binding CanSelectRptLoc}"
                                        ToolTip="{Binding RptFolderTip}"
                                        Visibility="{Binding CanSelectRptLoc, Converter={StaticResource BoolToVisibility}}" 
                                        Command="{Binding DataContext.SelectAppLocCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                        CommandParameter="{Binding}" />
                                    <TextBlock Text="{Binding Version}" Margin="1,0" VerticalAlignment="Center" Foreground="Red" />
                            </StackPanel>
                        </DataTemplate>
                     </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                </DataGrid.Columns>
          </DataGrid>
            <!-- 2. 左下DockPanel -->
            <DockPanel>
                <!-- 2. 左下-上功能按钮 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                    <Label Content="最新试验报表" Margin="4,0" VerticalAlignment="Bottom"/>
                    <Button Content="合并报表" Margin="1,0" 
                        IsEnabled="{Binding CanMergeRpt}" 
                        Command="{Binding MergeRptCommand}"
                        CommandParameter="{Binding RptFiles}" />
                <Button Content="预览报表 " Margin="1,0"
                        IsEnabled="{Binding CanPreviewMergedRpt}" 
                        Command="{Binding PreviewMergedRptCommand}"
                        CommandParameter="{Binding RptFiles}" />
                <Button Content="刷新报表" Margin="1,0"
                        Command="{Binding RefreshRptCommand}"
                        Visibility="Hidden"
                        CommandParameter="{Binding RptFiles}" />
            </StackPanel>
                <!-- 2. 左下-下最近报表试图 -->
                <DataGrid   ItemsSource="{Binding RptFiles}" 
                            IsReadOnly="True"
                            AutoGenerateColumns="False" 
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserResizeRows="False"
                            CanUserSortColumns="True"
                            HeadersVisibility="Column">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="报表类型" Binding="{Binding FileType}" Width="75" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="开关编号" Binding="{Binding SwitchNo}" Width="180" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="FileColumn"  Header="文件名" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                        <DataGridTextColumn Header="报表时间" 
                            Binding="{Binding TimeStamp,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                            Width="180"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="是否合并" Binding="{Binding Merged}" Width="75" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </DockPanel>
        
          <!-- 左右分割线 -->
          <GridSplitter Grid.Column="1"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Background="Gray"
               ShowsPreview="True" />

          <!-- 4. 右侧内容 -->
          <Grid Grid.Column="2" Background="LightBlue">
                <!--TextBlock Text="右侧面板" VerticalAlignment="Center" HorizontalAlignment="Center" /-->
                <DockPanel>
                <StackPanel Orientation="Horizontal"   DockPanel.Dock="Top">
                    <Label DockPanel.Dock="Top" Content="合并报表历史记录" VerticalAlignment="Bottom"/>
                    <Button Content="打印报表" Margin="1,0"                        
                        Command="{Binding OpenMergedRptCommand}"
                        IsEnabled="{Binding CanOpendMergedRpt}" 
                        CommandParameter="{Binding RptHis}" />
                    <Button Content="导出报表" Margin="1,0"                        
                        Command="{Binding ExportMergedRptCommand}"
                        IsEnabled="{Binding CanExportMergedRpt}" 
                        Visibility="Hidden"
                        CommandParameter="{Binding RptHis}" />
                </StackPanel>
                        
                <DataGrid ItemsSource="{Binding RptHis}" 
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        CanUserSortColumns="True"
                        HeadersVisibility="Column"
                        SelectionChanged="RptHisDataGrid_SelectionChanged"
                        GridLinesVisibility="All" >
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="开关编号" Binding="{Binding SwitchNo}" Width="180" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="报表最早时间"
                                            Binding="{Binding MinTime,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Width="170"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!--DataGridTextColumn Header="试验结束时间" Binding="{Binding MaxTime}" Width="220" IsReadOnly="True"/-->
                        <DataGridTextColumn Header="合并报表时间"
                                            Binding="{Binding CreateTime,StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Width="170" 
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                    </DataGrid>                
            </DockPanel>
          </Grid>
     </Grid>   
</Window>
