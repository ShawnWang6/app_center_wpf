<Window x:Class="CtrlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="App控制中心" Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei"
        FontSize="16">
    <Grid>
        <DataGrid Name="dataGridApps" AutoGenerateColumns="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="应用名称" Binding="{Binding Name}" Width="*" />
                <DataGridTemplateColumn Header="操作" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding ActionText}"
                    Foreground="{Binding ActionForeground}"
                    Click="ActionButton_Click"
                    Padding="8,4"
                    MinWidth="80"
                    HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="安装位置" Width="3*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Location}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding FullName}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Sync Directory" Binding="{Binding ScanFolder}" Width="*" />
                <DataGridTemplateColumn Header="Action" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Set" Visibility="{Binding ScanFolder, Converter={StaticResource EmptyToVisibilityConverter}}" Click="SetScanFolder_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <ListView Name="listViewExperimentOutput" Margin="10" Height="200" VerticalAlignment="Bottom">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="App Name" DisplayMemberBinding="{Binding FileType}" Width="150" />
                    <GridViewColumn Header="Switch No" DisplayMemberBinding="{Binding SwitchNo}" Width="150" />
                    <GridViewColumn Header="Experiment Time" DisplayMemberBinding="{Binding TimeStamp}" Width="150" />
                    <GridViewColumn Header="File Path" DisplayMemberBinding="{Binding FilePath}" Width="300" />
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
